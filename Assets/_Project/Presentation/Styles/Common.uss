/* =========================================================================
   APOGEE - Reusable UI Component Styles (GDD §14)
   ========================================================================= */

/* --- Base Layout --- */
.apogee-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: var(--color-bg-canvas);
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    overflow: hidden;
}

/* --- Panels & Cards --- */
.apogee-panel {
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-thin);
    border-radius: var(--border-radius-md);
    padding: var(--space-lg);
}

.apogee-panel--surface {
    background-color: var(--color-panel-surface);
}

.apogee-panel--elevated {
    border-color: var(--color-accent-cyan);
    background-color: var(--color-bg-canvas-elevated);
}

.apogee-panel-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-bottom: var(--space-md);
    border-bottom-width: var(--border-width-thin);
    border-bottom-color: var(--color-panel-border-subtle);
}

.apogee-panel-title {
    font-size: var(--font-size-lg);
    font-weight: bold;
    color: var(--color-text-primary);
    letter-spacing: 0.5px;
}

/* --- Buttons --- */
.apogee-button {
    background-color: var(--color-panel-surface);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-thin);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-primary);
    padding: var(--space-xs) var(--space-md);
    font-size: var(--font-size-sm);
    font-weight: bold;
    cursor: link;
    transition-property: background-color, border-color, scale;
    transition-duration: var(--transition-speed-fast);
}

.apogee-button:hover {
    background-color: var(--color-panel-surface-hover);
    border-color: var(--color-accent-cyan);
}

.apogee-button:active {
    background-color: var(--color-panel-surface-active);
    scale: 0.98;
}

.apogee-button--primary {
    background-color: var(--color-accent-cyan);
    border-color: var(--color-accent-cyan-light);
    color: #04121F;
}

.apogee-button--primary:hover {
    background-color: var(--color-accent-cyan-light);
    border-color: #FFFFFF;
}

.apogee-button--accent-amber {
    background-color: var(--color-accent-amber);
    border-color: var(--color-accent-amber-light);
    color: #1A0D00;
}

.apogee-button--danger {
    background-color: var(--color-accent-red);
    border-color: var(--color-accent-red-light);
    color: #FFFFFF;
}

.apogee-button:disabled {
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border-subtle);
    color: var(--color-text-disabled);
    opacity: 0.6;
}

/* Seçili durum — bütçe/pencere hedefi butonları için */
.apogee-button--selected {
    background-color: rgba(6, 182, 212, 0.18);
    border-color: var(--color-accent-cyan);
    border-width: 2px;
    color: var(--color-accent-cyan-light);
    font-weight: bold;
}

.apogee-button--selected:hover {
    background-color: rgba(6, 182, 212, 0.28);
    border-color: var(--color-accent-cyan-light);
}

/* Yatay panel splitter */
.apogee-splitter-handle--horizontal {
    width: 16px;
    height: 100%;
    margin-left: 4px;
    margin-right: 4px;
    align-items: center;
    justify-content: center;
    cursor: ew-resize;
    background-color: transparent;
    border-radius: var(--border-radius-sm);
    transition-property: background-color;
    transition-duration: var(--transition-speed-fast);
}

.apogee-splitter-handle--horizontal:hover {
    background-color: rgba(14, 165, 233, 0.12);
}

.apogee-splitter-handle--horizontal.apogee-splitter-handle--dragging {
    background-color: rgba(14, 165, 233, 0.25);
}

.apogee-splitter-grip--vertical {
    width: 3px;
    height: 56px;
    background-color: var(--color-panel-border);
    border-radius: 3px;
}

.apogee-splitter-handle--horizontal:hover .apogee-splitter-grip--vertical {
    background-color: var(--color-accent-cyan);
    height: 64px;
}

.apogee-splitter-handle--horizontal.apogee-splitter-handle--dragging .apogee-splitter-grip--vertical {
    background-color: var(--color-accent-cyan-light);
    height: 72px;
}

/* --- Status Badges --- */
.apogee-badge {
    padding: 2px var(--space-xs);
    border-radius: var(--border-radius-xs);
    font-size: var(--font-size-xs);
    font-weight: bold;
    border-width: var(--border-width-thin);
    border-color: transparent;
}

.apogee-badge--cyan {
    background-color: var(--color-accent-cyan-glow);
    border-color: var(--color-accent-cyan);
    color: var(--color-accent-cyan-light);
}

.apogee-badge--amber {
    background-color: var(--color-accent-amber-glow);
    border-color: var(--color-accent-amber);
    color: var(--color-accent-amber-light);
}

.apogee-badge--green {
    background-color: var(--color-accent-green-glow);
    border-color: var(--color-accent-green);
    color: var(--color-accent-green-light);
}

.apogee-badge--red {
    background-color: var(--color-accent-red-glow);
    border-color: var(--color-accent-red);
    color: var(--color-accent-red-light);
}

/* --- Status & Metric Progress Bars (GDD §8.3) --- */
.apogee-bar-container {
    height: 6px;
    background-color: rgba(5, 10, 20, 0.8);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-thin);
    border-radius: var(--border-radius-full);
    overflow: hidden;
    margin-top: var(--space-xs);
    margin-bottom: var(--space-xs);
}

.apogee-bar-fill {
    height: 100%;
    width: 0%;
    background-color: var(--color-accent-cyan);
    border-radius: var(--border-radius-full);
    transition-property: width;
    transition-duration: var(--transition-speed-normal);
}

.apogee-bar-fill--green {
    background-color: var(--color-accent-green);
}

.apogee-bar-fill--amber {
    background-color: var(--color-accent-amber);
}

.apogee-bar-fill--red {
    background-color: var(--color-accent-red);
}

/* --- Stat Metric Rows --- */
.apogee-stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-xs);
    padding-bottom: var(--space-xs);
    border-bottom-width: 1px;
    border-bottom-color: rgba(20, 40, 70, 0.6);
}

.apogee-stat-label {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
}

.apogee-stat-value {
    font-size: var(--font-size-sm);
    font-weight: bold;
    color: var(--color-text-primary);
}

/* --- Tooltip Box (GDD §13 & §14) --- */
.apogee-tooltip {
    position: absolute;
    background-color: var(--color-bg-canvas-dark);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-regular);
    border-radius: var(--border-radius-sm);
    padding: var(--space-sm) var(--space-md);
    max-width: 320px;
    min-width: 180px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--transition-speed-fast);
}

.apogee-tooltip--visible {
    opacity: 1;
}

.apogee-tooltip-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-xs);
    border-bottom-width: var(--border-width-thin);
    border-bottom-color: var(--color-panel-border-subtle);
    padding-bottom: var(--space-xxs);
}

.apogee-tooltip-title {
    font-size: var(--font-size-sm);
    font-weight: bold;
    color: var(--color-accent-cyan-light);
}

.apogee-tooltip-body {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    white-space: normal;
    margin-bottom: var(--space-xs);
}

.apogee-tooltip-reason {
    font-size: var(--font-size-xs);
    color: var(--color-accent-amber-light);
    border-left-width: var(--border-width-regular);
    border-left-color: var(--color-accent-amber);
    padding-left: var(--space-xs);
    margin-top: var(--space-xs);
    font-style: italic;
    white-space: normal;
}

.apogee-tooltip-delta {
    font-size: var(--font-size-xs);
    font-weight: bold;
    margin-top: var(--space-xxs);
}

.apogee-tooltip-delta--positive {
    color: var(--color-accent-green);
}

.apogee-tooltip-delta--negative {
    color: var(--color-accent-red);
}

/* ── M2-02 Modül-Slot & Hayalet Delta Stilleri ── */

.apogee-slot-item {
    background-color: var(--color-panel-surface);
    border-color: var(--color-panel-border-subtle);
    border-width: var(--border-width-thin);
    border-radius: var(--border-radius-md);
    padding: var(--space-sm) var(--space-md);
    margin-bottom: var(--space-sm);
    transition-property: background-color, border-color, translate;
    transition-duration: var(--transition-speed-fast);
}

.apogee-slot-item:hover {
    border-color: rgba(6, 182, 212, 0.45);
    background-color: rgba(30, 50, 80, 0.7);
    translate: 1px 0;
}

.apogee-slot-item--selected {
    border-color: var(--color-accent-cyan);
    border-width: var(--border-width-regular);
    background-color: rgba(14, 165, 233, 0.08);
}

.apogee-slot-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.apogee-slot-title {
    font-size: var(--font-size-xs);
    font-weight: bold;
    color: var(--color-text-primary);
}

.apogee-slot-equipped {
    font-size: var(--font-size-xs);
    color: var(--color-accent-cyan-light);
    margin-top: 2px;
}

.apogee-slot-equipped--empty {
    color: var(--color-text-muted);
    font-style: italic;
}

.apogee-slot-specs {
    font-size: 10px;
    color: var(--color-text-secondary);
    margin-top: 2px;
}

.apogee-module-drawer {
    margin-top: var(--space-xs);
    border-top-width: var(--border-width-thin);
    border-top-color: var(--color-panel-border-subtle);
    padding-top: var(--space-xs);
    flex-grow: 1;
}

.apogee-module-card {
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border-subtle);
    border-width: var(--border-width-thin);
    border-radius: var(--border-radius-sm);
    padding: var(--space-xs);
    margin-bottom: var(--space-xs);
    transition-property: background-color, border-color;
    transition-duration: var(--transition-speed-fast);
}

.apogee-module-card:hover {
    border-color: var(--color-accent-cyan);
    background-color: var(--color-panel-hover);
}

.apogee-module-card--equipped {
    border-color: var(--color-accent-green);
    border-width: var(--border-width-regular);
}

.apogee-module-card-title {
    font-size: var(--font-size-xs);
    font-weight: bold;
    color: var(--color-accent-cyan-light);
}

.apogee-module-card-badges {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.apogee-badge--mini {
    font-size: 9px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 1px;
    padding-bottom: 1px;
    margin-right: 4px;
    margin-bottom: 2px;
}

.apogee-ghost-delta {
    font-size: var(--font-size-xs);
    font-weight: bold;
    margin-left: var(--space-xs);
}

.apogee-ghost-delta--gain {
    color: var(--color-accent-green);
}

.apogee-ghost-delta--loss {
    color: var(--color-accent-red);
}

.apogee-ghost-delta--neutral {
    color: var(--color-accent-amber);
}

.apogee-ghost-summary-box {
    background-color: rgba(14, 165, 233, 0.12);
    border-color: var(--color-accent-cyan);
    border-width: var(--border-width-thin);
    border-radius: var(--border-radius-sm);
    padding: var(--space-xs);
    margin-top: var(--space-sm);
}

.apogee-ghost-summary-title {
    font-size: 10px;
    font-weight: bold;
    color: var(--color-accent-cyan-light);
    letter-spacing: 0.5px;
}

.apogee-ghost-summary-text {
    font-size: var(--font-size-xs);
    color: var(--color-text-primary);
    margin-top: 2px;
    white-space: normal;
}

/* ── M2-04 Sonuç Paneli (Results Panel) Stilleri (GDD §8.3) ── */

.apogee-results-bar {
    margin-bottom: var(--space-sm);
}

.apogee-results-bar__value {
    font-weight: bold;
    font-size: var(--font-size-xs);
    min-width: 120px;
    text-align: right;
    -unity-text-align: upper-right;
}

.apogee-results-bar__value--good {
    color: var(--color-accent-green-light);
}

.apogee-results-bar__value--warn {
    color: var(--color-accent-amber-light);
}

.apogee-results-bar__value--error {
    color: var(--color-accent-red-light);
}

.apogee-results-bar__reason {
    font-size: 10px;
    color: var(--color-text-muted);
    white-space: normal;
    margin-top: 2px;
    font-style: italic;
    padding-left: var(--space-xs);
    border-left-width: 2px;
    border-left-color: var(--color-panel-border-subtle);
}

/* ── M2-03 Roket/Araç Kesit Görünümü (CAD Assembly) Stilleri ── */

.apogee-cad-view {
    flex-grow: 1;
}

.apogee-cad-viewport {
    background-color: #060C15;
    border-color: #0F2035;
    border-width: var(--border-width-thin);
    border-radius: 10px;
}

/* Izgara deseni efekti — viewport arka planına ince mavi çizgiler */
.apogee-cad-viewport::before {
    background-image: none;
}

.apogee-cad-part {
    transition-property: border-color, background-color, border-width, translate;
    transition-duration: var(--transition-speed-fast);
    cursor: link;
    margin-left: auto;
    margin-right: auto;
}

.apogee-cad-part:hover {
    border-color: rgba(34, 180, 255, 0.75);
    background-color: rgba(14, 40, 80, 0.7);
    translate: 0 -1px;
}

.apogee-cad-part--selected {
    border-color: var(--color-accent-cyan);
    border-width: var(--border-width-regular);
    background-color: rgba(14, 165, 233, 0.12);
}

.apogee-cad-part--empty {
    border-style: dashed;
    border-color: rgba(100, 120, 150, 0.5);
    opacity: 0.75;
}

.apogee-cad-snap-line {
    background-color: var(--color-accent-cyan-subtle);
}

.apogee-cad-ruler {
    background-color: rgba(2, 5, 10, 0.95);
    border-right-color: rgba(15, 32, 55, 0.9);
    border-right-width: 1px;
}

.apogee-cad-topbar {
    border-bottom-color: rgba(12, 24, 44, 0.9);
    border-bottom-width: 1px;
}

/* ── M2 Modül Çekmecesi Splitter Resizer Handle ── */

.apogee-splitter-handle {
    height: 16px;
    margin-top: 6px;
    margin-bottom: 6px;
    align-items: center;
    justify-content: center;
    cursor: split-resize-up-down;
    background-color: transparent;
    border-radius: var(--border-radius-sm);
    transition-property: background-color;
    transition-duration: var(--transition-speed-fast);
}

.apogee-splitter-handle:hover {
    background-color: rgba(14, 165, 233, 0.12);
}

.apogee-splitter-handle--dragging {
    background-color: rgba(14, 165, 233, 0.25);
}

.apogee-splitter-grip {
    width: 56px;
    height: 3px;
    background-color: var(--color-panel-border);
    border-radius: 3px;
}

.apogee-splitter-handle:hover .apogee-splitter-grip {
    background-color: var(--color-accent-cyan);
    width: 64px;
}

.apogee-splitter-handle--dragging .apogee-splitter-grip {
    background-color: var(--color-accent-cyan-light);
    width: 72px;
}

/* ── M2-05 Design Review Screen & Traffic-Light Issues ── */

.apogee-review-filter-bar {
    flex-direction: row;
    margin-bottom: var(--space-xs);
    align-items: center;
}

.apogee-review-filter-btn {
    padding: 3px var(--space-sm);
    margin-right: var(--space-xs);
    font-size: var(--font-size-xs);
    border-radius: var(--border-radius-sm);
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border-subtle);
    border-width: var(--border-width-thin);
    color: var(--color-text-secondary);
    transition-property: background-color, border-color, color;
    transition-duration: var(--transition-speed-fast);
}

.apogee-review-filter-btn:hover {
    background-color: var(--color-panel-hover);
    color: var(--color-text-primary);
}

.apogee-review-filter-btn--active {
    background-color: var(--color-accent-cyan-glow);
    border-color: var(--color-accent-cyan);
    color: var(--color-accent-cyan-light);
    font-weight: bold;
}

.apogee-review-card {
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border-subtle);
    border-width: var(--border-width-thin);
    border-radius: var(--border-radius-sm);
    padding: var(--space-xs) var(--space-sm);
    margin-bottom: var(--space-xs);
    transition-property: background-color, border-color;
    transition-duration: var(--transition-speed-fast);
}

.apogee-review-card:hover {
    background-color: var(--color-panel-hover);
}

.apogee-review-card--error {
    border-left-color: var(--color-accent-red);
    border-left-width: 4px;
}

.apogee-review-card--warning {
    border-left-color: var(--color-accent-amber);
    border-left-width: 4px;
}

.apogee-review-card--pass {
    border-left-color: var(--color-accent-green);
    border-left-width: 4px;
}

.apogee-review-reason {
    font-size: var(--font-size-xs);
    color: var(--color-text-primary);
    white-space: normal;
    margin-top: 3px;
    line-height: 1.3;
}

.apogee-review-hint {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-style: italic;
    white-space: normal;
    margin-top: 3px;
    line-height: 1.3;
}



/* ── M3-03 Mission Claim Level & Risk/Reward Card ── */

.mission-claim-card {
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-thin);
    border-radius: var(--border-radius-md);
    padding: var(--space-sm);
    margin-bottom: var(--space-sm);
}

.mission-claim-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-xs);
}

.mission-claim-title {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    font-weight: bold;
    letter-spacing: 0.5px;
    margin-right: var(--space-sm);
}

.claim-badge {
    padding: 2px 8px;
    border-radius: 10px;
    font-size: var(--font-size-xs);
    font-weight: bold;
    border-width: 1px;
    margin-right: var(--space-sm);
}

.claim-badge--low {
    background-color: rgba(6, 182, 212, 0.15);
    border-color: var(--color-accent-cyan);
    color: var(--color-accent-cyan-light);
}

.claim-badge--medium {
    background-color: rgba(245, 158, 11, 0.15);
    border-color: var(--color-accent-amber);
    color: var(--color-accent-amber-light);
}

.claim-badge--high {
    background-color: rgba(249, 115, 22, 0.15);
    border-color: #F97316;
    color: #FDBA74;
}

.claim-badge--extreme {
    background-color: rgba(239, 68, 68, 0.15);
    border-color: var(--color-accent-red);
    color: var(--color-accent-red-light);
}

.claim-score-pill {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    background-color: var(--color-panel-surface);
    border-radius: var(--border-radius-sm);
    padding: 2px 6px;
    margin-left: auto;
}

.mission-claim-body {
    flex-direction: row;
}

.claim-summary-box {
    flex: 1;
    background-color: var(--color-panel-surface);
    border-radius: var(--border-radius-sm);
    padding: var(--space-xs) var(--space-sm);
    margin-right: var(--space-xs);
    border-left-width: 3px;
}

.claim-summary-box:last-child {
    margin-right: 0;
}

.claim-summary-box--reward {
    border-left-color: var(--color-accent-cyan);
}

.claim-summary-box--risk {
    border-left-color: var(--color-accent-amber);
}

.claim-summary-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
}

.claim-summary-title {
    font-size: 9px;
    color: var(--color-text-muted);
    font-weight: bold;
    letter-spacing: 0.5px;
}

.claim-metric-pill {
    font-size: 10px;
    font-weight: bold;
    padding: 1px 5px;
    border-radius: 4px;
}

.claim-metric-pill--reward {
    color: var(--color-accent-cyan-light);
    background-color: rgba(6, 182, 212, 0.15);
}

.claim-metric-pill--risk {
    color: var(--color-accent-amber-light);
    background-color: rgba(245, 158, 11, 0.15);
}

.claim-summary-text {
    font-size: var(--font-size-xs);
    color: var(--color-text-primary);
    white-space: normal;
    line-height: 1.25;
}

/* =========================================================================
   Mission Composer Wizard Styles (GDD §5, §14.1 #5, M3-04)
   ========================================================================= */

.composer-subtitle {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-top: 2px;
}

.composer-step-bar {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-panel-surface);
    border-color: var(--color-panel-border);
    border-width: 1px;
    border-radius: var(--border-radius-md);
    padding: 4px;
    margin-bottom: 12px;
}

.composer-step-tab {
    flex: 1;
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: bold;
    padding: 8px 12px;
    margin: 0 2px;
    border-radius: var(--border-radius-sm);
    transition-property: background-color, color, border-bottom-color;
    transition-duration: var(--transition-speed-fast);
}

.composer-step-tab:hover {
    background-color: var(--color-panel-surface-hover);
    color: var(--color-text-primary);
}

.composer-step-tab--active {
    background-color: var(--color-panel-bg);
    color: var(--color-accent-cyan-light);
    border-bottom-color: var(--color-accent-cyan);
}

.composer-step-tab--completed {
    color: var(--color-text-primary);
    border-bottom-color: rgba(6, 182, 212, 0.4);
}

.composer-step-panel {
    flex-grow: 1;
    padding: 14px;
}

.composer-step-guide {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-bottom: 12px;
    line-height: 1.3;
}

.composer-cards-grid {
    flex-grow: 1;
}

.composer-card {
    background-color: var(--color-panel-surface);
    border-color: var(--color-panel-border);
    border-width: 1px;
    border-radius: var(--border-radius-md);
    padding: 10px 14px;
    margin-bottom: 8px;
    cursor: link;
    transition-property: background-color, border-color, scale;
    transition-duration: var(--transition-speed-fast);
}

.composer-card:hover {
    background-color: var(--color-panel-surface-hover);
    border-color: var(--color-accent-cyan-light);
}

.composer-card--selected {
    background-color: var(--color-bg-canvas-elevated);
    border-color: var(--color-accent-cyan);
    border-width: 2px;
}

.composer-card-title {
    font-size: var(--font-size-sm);
    font-weight: bold;
    color: var(--color-text-primary);
}

.composer-card-desc {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-top: 2px;
    margin-bottom: 6px;
}

.composer-objectives-list {
    flex-grow: 1;
}

.composer-objective-item {
    background-color: var(--color-panel-surface);
    border-color: var(--color-panel-border);
    border-width: 1px;
    border-radius: var(--border-radius-sm);
    padding: 8px 12px;
    margin-bottom: 6px;
    cursor: link;
    transition-property: background-color, border-color;
    transition-duration: var(--transition-speed-fast);
}

.composer-objective-item:hover {
    background-color: var(--color-panel-surface-hover);
    border-color: var(--color-accent-cyan-light);
}

.composer-objective-item--selected {
    background-color: rgba(6, 182, 212, 0.08);
    border-color: var(--color-accent-cyan);
    border-left-width: 3px;
    border-left-color: var(--color-accent-cyan);
}

.composer-section-title {
    font-size: 10px;
    font-weight: bold;
    color: var(--color-text-muted);
    letter-spacing: 0.5px;
    margin-bottom: 6px;
}

.composer-window-option {
    background-color: var(--color-panel-surface);
    border-color: var(--color-panel-border);
    border-width: 1px;
    border-radius: var(--border-radius-sm);
    padding: 8px 12px;
    margin-bottom: 6px;
}

.composer-window-option--selected {
    border-color: var(--color-accent-cyan);
    background-color: rgba(6, 182, 212, 0.08);
    border-left-width: 3px;
    border-left-color: var(--color-accent-cyan);
}

.composer-window-option-title {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: bold;
    color: var(--color-text-primary);
    text-align: left;
}

.composer-window-option-desc {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-top: 3px;
}

.composer-footer-bar {
    margin-top: 10px;
    padding: 10px 16px;
}

.composer-step-indicator-label {
    font-size: var(--font-size-sm);
    font-weight: bold;
    color: var(--color-text-primary);
}


/* =========================================================================
   10. MISSION DOSSIER SCREEN (GDD §5.4, §5.5, §14.1 item 6, §21 M3-05)
   ========================================================================= */

.dossier-screen {
    background-color: var(--color-space-black);
}

.dossier-header {
    border-bottom-width: var(--border-width-thin);
    border-bottom-color: var(--color-panel-border);
}

.dossier-metric-card {
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border-subtle);
    border-width: var(--border-width-thin);
    border-radius: var(--border-radius-sm);
    padding: var(--space-xs) var(--space-sm);
    margin-bottom: var(--space-xs);
}

.dossier-metric-title {
    font-size: 10px;
    font-weight: bold;
    color: var(--color-text-muted);
    letter-spacing: 0.5px;
    margin-bottom: 2px;
}

.dossier-metric-value {
    font-size: var(--font-size-md);
    font-weight: bold;
    color: var(--color-accent-cyan-light);
    margin-bottom: 2px;
}

.dossier-metric-desc {
    font-size: 10px;
    color: var(--color-text-muted);
    white-space: normal;
}

.dossier-req-card {
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border-subtle);
    border-width: var(--border-width-thin);
    border-left-width: 3px;
    border-left-color: var(--color-accent-cyan);
    border-radius: var(--border-radius-sm);
    padding: var(--space-xs) var(--space-sm);
    margin-bottom: var(--space-xs);
}

.dossier-req-title {
    font-size: var(--font-size-xs);
    font-weight: bold;
    color: var(--color-text-primary);
}

.dossier-req-desc {
    font-size: 11px;
    color: var(--color-text-secondary);
    white-space: normal;
    margin-top: 3px;
    line-height: 1.3;
}

.dossier-research-item {
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border-subtle);
    border-width: var(--border-width-thin);
    border-radius: var(--border-radius-sm);
    padding: var(--space-xs) var(--space-sm);
    margin-bottom: var(--space-xs);
}

.dossier-research-item--locked {
    border-left-width: 3px;
    border-left-color: var(--color-accent-amber);
}

.dossier-research-title {
    font-size: var(--font-size-xs);
    font-weight: bold;
    color: var(--color-text-primary);
}

.dossier-research-desc {
    font-size: 10px;
    color: var(--color-text-muted);
    white-space: normal;
    margin-top: 2px;
    line-height: 1.25;
}

.dossier-criterion-card {
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border-subtle);
    border-width: var(--border-width-thin);
    border-radius: var(--border-radius-sm);
    padding: var(--space-xs) var(--space-sm);
    margin-bottom: var(--space-xs);
}

.dossier-criterion-text {
    font-size: 11px;
    color: var(--color-text-primary);
    white-space: normal;
    flex-grow: 1;
    margin-right: var(--space-xs);
}

/* =========================================================================
   M8-01 Visual Polish: Transitions, Glowing Accents, Maps & Telemetry
   ========================================================================= */

/* --- Standardized Buttons & Tab Buttons --- */
.apogee-btn {
    background-color: var(--color-panel-surface);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-thin);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-primary);
    padding: var(--space-xs) var(--space-md);
    font-size: var(--font-size-sm);
    font-weight: bold;
    cursor: link;
    transition-property: background-color, border-color, scale;
    transition-duration: var(--transition-speed-fast);
}

.apogee-btn:hover {
    background-color: var(--color-panel-surface-hover);
    border-color: var(--color-accent-cyan);
    scale: 1.02;
}

.apogee-btn:active {
    background-color: var(--color-panel-surface-active);
    scale: 0.98;
}

.apogee-btn--primary {
    background-color: var(--color-accent-cyan);
    border-color: var(--color-accent-cyan-light);
    color: var(--color-bg-canvas-dark);
}

.apogee-btn--primary:hover {
    background-color: var(--color-accent-cyan-light);
    border-color: #FFFFFF;
}

.apogee-btn--secondary {
    background-color: transparent;
    border-color: var(--color-panel-border);
    color: var(--color-text-secondary);
}

.apogee-btn--secondary:hover {
    background-color: var(--color-panel-surface);
    border-color: var(--color-text-primary);
    color: var(--color-text-primary);
}

.apogee-btn--go {
    background-color: var(--color-accent-green);
    border-color: var(--color-accent-green-light);
    color: var(--color-bg-canvas-dark);
    font-weight: bold;
}

.apogee-btn--go:hover {
    background-color: var(--color-accent-green-light);
    scale: 1.03;
}

.apogee-btn--danger {
    background-color: var(--color-accent-red);
    border-color: var(--color-accent-red-light);
    color: #FFFFFF;
}

.apogee-tab-btn {
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border-subtle);
    border-width: var(--border-width-thin);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-muted);
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--font-size-xs);
    font-weight: bold;
    cursor: link;
    transition-property: background-color, border-color, color;
    transition-duration: var(--transition-speed-fast);
}

.apogee-tab-btn:hover {
    background-color: var(--color-panel-surface);
    border-color: var(--color-panel-border);
    color: var(--color-text-primary);
}

.apogee-tab-btn--active,
.apogee-tab-btn--selected {
    background-color: var(--color-panel-surface-hover);
    border-color: var(--color-accent-cyan);
    color: var(--color-accent-cyan-light);
}

/* --- Glowing Accent Highlights --- */
.apogee-glow--cyan {
    border-color: var(--color-accent-cyan);
    background-color: rgba(6, 182, 212, 0.08);
}

.apogee-glow--amber {
    border-color: var(--color-accent-amber);
    background-color: rgba(245, 158, 11, 0.08);
}

.apogee-glow--green {
    border-color: var(--color-accent-green);
    background-color: rgba(16, 185, 129, 0.08);
}

.apogee-glow--red {
    border-color: var(--color-accent-red);
    background-color: rgba(239, 68, 68, 0.08);
}

/* --- Animated Telemetry Fill & Progress Bars --- */
.telemetry-bar-fill--animated {
    transition-property: width, background-color;
    transition-duration: 250ms;
}

/* --- Interactive Card Transitions --- */
.apogee-card--interactive {
    cursor: link;
    transition-property: background-color, border-color, scale;
    transition-duration: var(--transition-speed-fast);
}

.apogee-card--interactive:hover {
    border-color: var(--color-accent-cyan);
    background-color: var(--color-panel-surface-hover);
    scale: 1.01;
}

/* --- Map & Solar Visual Polish --- */
.map-viewport-grid {
    border-color: rgba(6, 182, 212, 0.15);
    border-width: 1px;
}

.map-radar-ring {
    border-color: rgba(6, 182, 212, 0.2);
    border-width: 1px;
    border-radius: var(--border-radius-full);
}

.map-region-node {
    border-radius: var(--border-radius-full);
    border-width: 2px;
    border-color: var(--color-accent-cyan);
    background-color: rgba(6, 182, 212, 0.3);
    cursor: link;
    transition-property: scale, background-color;
    transition-duration: var(--transition-speed-fast);
}

.map-region-node:hover {
    scale: 1.25;
    background-color: var(--color-accent-cyan);
}

.solar-orbit-line {
    border-color: rgba(100, 116, 139, 0.25);
    border-width: 1px;
    border-radius: var(--border-radius-full);
}

.solar-planet-marker {
    border-radius: var(--border-radius-full);
    cursor: link;
    transition-property: scale, border-color;
    transition-duration: var(--transition-speed-fast);
}

.solar-planet-marker:hover {
    scale: 1.3;
    border-color: #FFFFFF;
}

/* --- Global TextFields & Inputs Override --- */
.unity-text-field__input {
    background-color: #0d1522;
    color: #f8fafc;
    border-color: #2b3d58;
    border-width: 1px;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
    -unity-font-style: bold;
}

.unity-text-field__input:focus {
    border-color: #38bdf8;
}

/* =========================================================================
   Hangar Redesign Styles (GDD §7, §14.3, §15.1, ADR-054)
   ========================================================================= */

.apogee-hangar-root {
    flex-grow: 1;
    background-color: var(--color-hangar-bg);
    overflow: hidden;
    position: relative;
}

.apogee-hangar-topbar {
    background-color: var(--color-panel-bg);
    border-bottom-width: var(--border-width-thin);
    border-bottom-color: var(--color-panel-border-subtle);
    padding: var(--space-xs) var(--space-md);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    z-index: 10;
}

.apogee-hangar-layer-btn {
    background-color: var(--color-panel-surface);
    border-color: var(--color-panel-border-subtle);
    border-width: var(--border-width-thin);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
    padding: var(--space-xs) var(--space-sm);
    margin-right: var(--space-xs);
    transition-property: background-color, border-color, color;
    transition-duration: var(--transition-speed-fast);
}

.apogee-hangar-layer-btn:hover {
    background-color: var(--color-panel-surface-hover);
    color: var(--color-text-primary);
    border-color: var(--color-accent-cyan);
}

.apogee-hangar-layer-btn--active {
    background-color: var(--color-panel-surface-active);
    border-color: var(--color-accent-cyan);
    color: var(--color-accent-cyan-light);
    -unity-font-style: bold;
}

.apogee-hangar-hud {
    background-color: var(--color-panel-bg);
    border-top-width: var(--border-width-thin);
    border-top-color: var(--color-panel-border-subtle);
    padding: var(--space-sm) var(--space-lg);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    z-index: 10;
}

.apogee-hangar-hud-metric {
    flex-direction: column;
    margin-right: var(--space-xl);
}

.apogee-hangar-card {
    background-color: var(--color-panel-surface);
    border-color: var(--color-panel-border-subtle);
    border-width: var(--border-width-thin);
    border-radius: var(--border-radius-md);
    transition-property: background-color, border-color, scale;
    transition-duration: var(--transition-speed-fast);
}

.apogee-hangar-card:hover {
    border-color: var(--color-accent-cyan);
    background-color: var(--color-panel-surface-hover);
    scale: 1.01;
}

.apogee-hangar-engineering-panel {
    position: absolute;
    left: 160px;
    top: 50px;
    bottom: 80px;
    width: 320px;
    background-color: rgba(14, 22, 36, 0.96);
    border-right-width: 1px;
    border-right-color: var(--color-panel-border);
    padding: var(--space-md);
    z-index: 20;
}

